{
  "name": "permsy",
  "version": "1.0.0",
  "description": "A modern permission and command management engine for Node.js applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umit-Ulusoy/permsy.git"
  },
  "keywords": [
    "permissions",
    "discord",
    "command-handler",
    "rbac",
    "security",
    "typescript"
  ],
  "author": "Ümit Ulusoy",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Umit-Ulusoy/permsy/issues"
  },
  "homepage": "https://github.com/Umit-Ulusoy/permsy#readme",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^4.1.10",
  "tsup": "^8.5.1",
  "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}